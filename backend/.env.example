# Backend Example .env
# This file documents the recommended environment variables for FastAPI backend container

# Path to SQLite DB file INSIDE the backend container.
# Must match the volume mapping! (see backend/DEBUG_502_BAD_GATEWAY_ANALYSIS.md)
SQLITE_DB=/app/database/myapp.db

# FastAPI server port (default used by uvicorn)
PORT=8000

# --------
# USAGE:
# Mount your (persistent/shared) database from the host or another container at the _SAME_ path as specified here.
# Example Docker Compose service for backend:
#   volumes:
#     - ./database/myapp.db:/app/database/myapp.db
#   env_file:
#     - ./backend/.env
